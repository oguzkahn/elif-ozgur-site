
---
import bilgiler from "../data/site-bilgileri.json";
---

<footer class="site-footer">
  <div class="footer-container">

    <div class="footer-top">
      <div class="footer-brand">
        <h2>Elif Özgür Önal</h2>
        <p>Klinik Psikolog · Serdivan, Sakarya</p>
      </div>

      <nav class="footer-links" aria-label="Sosyal medya ve profiller">
  <a
    href={bilgiler.instagram}
    target="_blank"
    rel="noopener noreferrer"
    class="footer-social-link"
  >
    <span class="footer-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.3" cy="6.7" r="1"></circle>
      </svg>
    </span>
    <span>Instagram</span>
    <span aria-hidden="true">↗</span>
  </a>

  <a
    href={bilgiler.doktorsitesi}
    target="_blank"
    rel="noopener noreferrer"
    class="footer-social-link"
  >
    <span class="footer-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <circle cx="12" cy="8" r="3.2"></circle>
        <path d="M5.5 19c1.8-3.2 4-4.8 6.5-4.8S16.7 15.8 18.5 19"></path>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4"></rect>
      </svg>
    </span>
    <span>DoktorSitesi</span>
    <span aria-hidden="true">↗</span>
  </a>
</nav>
    </div>

    <div class="footer-bottom">
      <p>
        © {new Date().getFullYear()} Elif Özgür Önal
      </p>

      <p>
        Son içerik güncellemesi:
        <time>{bilgiler.sonGuncelleme}</time>
      </p>

      <p>
        Site editörü iletişim:
        <a href={`mailto:${bilgiler.editorEposta}`}>
          {bilgiler.editorEposta}
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #eaece4;
    color: #293b34;
    padding: 52px 0 28px;
  }

  .footer-container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .footer-top {
    display: flex;
    justify-content: space-between;
    gap: 30px;
    padding-bottom: 36px;
    border-bottom: 1px solid #d2dccf;
  }

  .footer-brand h2 {
    font-family: Georgia, serif;
    font-size: 27px;
    font-weight: normal;
    margin: 0 0 12px;
  }

  .footer-brand p {
    font-size: 13px;
    color: #718075;
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 25px;
    align-items: center;
    flex-wrap: wrap;
  }

  .footer-links a,
  .footer-bottom a {
    color: #355b4b;
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-bottom a:hover {
    text-decoration: underline;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    padding-top: 24px;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 12px;
    line-height: 1.8;
    color: #718075;
  }

  @media (max-width: 700px) {
    .footer-container {
      padding: 0 20px;
    }

    .footer-top {
      flex-direction: column;
    }

    .footer-bottom {
      flex-direction: column;
    }
  }

  .footer-social-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
}

.footer-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 18px;
  height: 18px;
  flex: 0 0 18px;
}

.footer-icon svg {
  width: 18px;
  height: 18px;
  display: block;
}
</style>

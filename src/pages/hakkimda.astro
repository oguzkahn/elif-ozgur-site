
---
const egitimler = [
  {
    baslik: "Lisans Eğitimi",
    okul: "Uludağ Üniversitesi",
    bolum: "Psikoloji"
  },
  {
    baslik: "Yüksek Lisans",
    okul: "Üsküdar Üniversitesi",
    bolum: "Klinik Psikoloji"
  }
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Hakkımda | Klinik Psikolog Elif Özgür Önal</title>

    <meta
      name="description"
      content="Klinik Psikolog Elif Özgür Önal'ın eğitimi, mesleki yaklaşımı ve psikoterapi çalışmalarına ilişkin bilgiler."
    />
  </head>

  <body>
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="brand">
          <img
            src="/images/logo.png"
            alt="Elif Özgür Önal"
            width="180"
          />
        </a>

        <a href="/" class="back-link">← Ana Sayfa</a>
      </div>
    </header>

    <main>
      <section class="page-heading">
        <div class="container">
          <span class="eyebrow">BENİ TANIYIN</span>
          <h1>Hakkımda<span>.</span></h1>
          <p>Klinik Psikolog Elif Özgür Önal</p>
        </div>
      </section>

      <section class="about">
        <div class="container about-grid">
          <div class="portrait">
            <img
              src="/images/elif-ozgur-onal.jpg"
              alt="Klinik Psikolog Elif Özgür Önal"
            />
          </div>

          <div class="about-text">
            <span class="eyebrow">MERHABA</span>
            <h2>Ben Elif Özgür Önal.</h2>

            <p>
              Lisans eğitimimi Uludağ Üniversitesi Psikoloji
              Bölümünde, yüksek lisans eğitimimi ise
              Üsküdar Üniversitesi Klinik Psikoloji
              alanında tamamladım.
            </p>

            <p>
              Mesleki çalışmalarımda çocuk, ergen ve
              yetişkinlerle çalışıyorum.
            </p>

            <p>
              Bilişsel Davranışçı Terapi, EMDR ve Deneyimsel
              Oyun Terapisi yaklaşımlarına ilişkin eğitimler
              aldım.
            </p>

            <p>
              Sakarya Serdivan'da yüz yüze görüşmeler
              gerçekleştiriyorum.
            </p>

            <a href="/#iletisim" class="button">
              İletişime Geçin ↗
            </a>
          </div>
        </div>
      </section>

      <section class="education">
        <div class="container">
          <span class="eyebrow">AKADEMİK GEÇMİŞ</span>
          <h2>Eğitim Bilgileri<span>.</span></h2>

          <div class="education-grid">
            {egitimler.map((egitim) => (
              <article class="education-card">
                <span>{egitim.baslik}</span>
                <h3>{egitim.okul}</h3>
                <p>{egitim.bolum}</p>
              </article>
            ))}
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">
        <p>© 2026 Elif Özgür Önal. Tüm hakları saklıdır.</p>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #293b34;
    font-family: Arial, Helvetica, sans-serif;
  }

  .container {
    max-width: 1160px;
    margin: auto;
    padding: 0 28px;
  }

  .header {
    border-bottom: 1px solid #e8e6df;
    background: #f8f6f1;
  }

  .header-inner {
    min-height: 90px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .brand img {
    display: block;
    max-width: 180px;
    height: auto;
  }

  .back-link {
    color: #355b4b;
    text-decoration: none;
    font-size: 14px;
  }

  .page-heading {
    padding: 90px 0;
    background: #eaece4;
  }

  .eyebrow {
    color: #72917e;
    letter-spacing: 3px;
    font-size: 11px;
    font-weight: bold;
  }

  h1, h2, h3 {
    font-family: Georgia, serif;
    font-weight: normal;
  }

  h1 {
    font-size: clamp(52px, 7vw, 86px);
    margin: 18px 0;
  }

  h1 span, h2 span {
    color: #86a590;
  }

  .page-heading p {
    color: #718075;
    font-size: 17px;
  }

  .about {
    padding: 110px 0;
  }

  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 85px;
    align-items: center;
  }

  .portrait {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 190px 190px 6px 6px;
    background: #dce5da;
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 28%;
  }

  h2 {
    font-size: clamp(35px, 4vw, 52px);
    margin: 18px 0 30px;
  }

  .about-text p {
    font-size: 15px;
    line-height: 2;
    color: #69776e;
    margin-bottom: 20px;
  }

  .button {
    display: inline-block;
    margin-top: 15px;
    padding: 17px 26px;
    background: #355b4b;
    color: #fff;
    text-decoration: none;
    border-radius: 4px;
    font-size: 14px;
  }

  .education {
    padding: 100px 0;
    background: #f0f1eb;
  }

  .education-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .education-card {
    background: #fbfaf6;
    padding: 40px;
  }

  .education-card > span {
    font-size: 11px;
    letter-spacing: 2px;
    color: #72917e;
  }

  .education-card h3 {
    font-size: 27px;
    margin: 22px 0 12px;
  }

  .education-card p {
    color: #718075;
  }

  footer {
    padding: 30px 0;
    background: #eaece4;
    color: #718075;
    font-size: 12px;
  }

  @media (max-width: 800px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .portrait {
      max-width: 450px;
    }

    .education-grid {
      grid-template-columns: 1fr;
    }

    .about, .education {
      padding: 65px 0;
    }

    .page-heading {
      padding: 65px 0;
    }
  }

  @media (max-width: 480px) {
    .container {
      padding: 0 20px;
    }

    .education-card {
      padding: 28px;
    }
  }
</style>

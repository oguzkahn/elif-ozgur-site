
---
const alanlar = [
  {
    no: "01",
    baslik: "Bireysel Terapi",
    aciklama: "Yetişkinlerin duygusal, düşünsel ve davranışsal güçlüklerini ele almaya yönelik psikoterapi görüşmeleri."
  },
  {
    no: "02",
    baslik: "Çocuk ve Ergen Terapisi",
    aciklama: "Çocukluk ve ergenlik dönemlerine özgü duygusal, sosyal ve gelişimsel ihtiyaçlara yönelik çalışmalar."
  },
  {
    no: "03",
    baslik: "Ebeveyn Danışmanlığı",
    aciklama: "Ebeveynlerin çocuklarının gelişim süreçlerini anlamalarına ve aile içi iletişimi değerlendirmelerine yönelik görüşmeler."
  },
  {
    no: "04",
    baslik: "EMDR Terapisi",
    aciklama: "Danışanın ihtiyaçları ve klinik değerlendirme doğrultusunda EMDR yaklaşımının kullanıldığı psikoterapi çalışmaları."
  },
  {
    no: "05",
    baslik: "Deneyimsel Oyun Terapisi",
    aciklama: "Çocukların oyun aracılığıyla duygu ve deneyimlerini ifade etmelerine odaklanan terapi yaklaşımı."
  },
  {
    no: "06",
    baslik: "Psikolojik Değerlendirme",
    aciklama: "İhtiyaca ve uygulama yetkinliğine göre seçilen psikolojik ve gelişimsel değerlendirme araçları."
  }
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f6f1" />
    <title>Çalışma Alanları | Klinik Psikolog Elif Özgür Önal</title>
    <meta
      name="description"
      content="Klinik Psikolog Elif Özgür Önal'ın Sakarya Serdivan'daki psikoterapi, çocuk ve ergen terapisi ve psikolojik değerlendirme çalışma alanları."
    />
  </head>
  <body>
    <header class="header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="Ana sayfa">
          <img
            src="/images/logo.png"
            alt="Klinik Psikolog Elif Özgür Önal"
            width="220"
            height="75"
          />
        </a>

        <nav class="desktop-nav" aria-label="Ana menü">
          <a href="/">Ana Sayfa</a>
          <a href="/hakkimda">Hakkımda</a>
          <a href="/calisma-alanlari" aria-current="page">Çalışma Alanları</a>
          <a href="/#iletisim" class="contact-link">İletişim</a>
        </nav>

        <details class="mobile-menu">
          <summary>Menü <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobil menü">
            <a href="/">Ana Sayfa</a>
            <a href="/hakkimda">Hakkımda</a>
            <a href="/calisma-alanlari">Çalışma Alanları</a>
            <a href="/#iletisim">İletişim</a>
          </nav>
        </details>
      </div>
    </header>

    <main>
      <section class="page-heading">
        <div class="container">
          <span class="eyebrow">PSİKOLOJİK DESTEK</span>
          <h1>Çalışma Alanları<span>.</span></h1>
          <p>
            Her bireyin yaşam öyküsü ve ihtiyaçları farklıdır.
            Psikolojik destek süreci bu ihtiyaçlar doğrultusunda ele alınır.
          </p>
        </div>
      </section>

      <section class="services">
        <div class="container">
          <div class="service-grid">
            {alanlar.map((alan) => (
              <article class="service-card">
                <span class="number">{alan.no}</span>
                <h2>{alan.baslik}</h2>
                <p>{alan.aciklama}</p>
                <span class="line"></span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="contact-section">
        <div class="container contact-inner">
          <div>
            <span class="eyebrow">İLETİŞİM</span>
            <h2>Görüşme hakkında bilgi alın.</h2>
            <p>
              Çalışma alanları ve görüşme süreci hakkında
              bilgi almak için iletişime geçebilirsiniz.
            </p>
          </div>
          <a href="/#iletisim" class="button">
            İletişime Geçin ↗
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>Elif Özgür Önal · Klinik Psikolog</span>
        <span>© 2026 Tüm hakları saklıdır.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #293b34;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(a) { color: inherit; }

  .container {
    max-width: 1160px;
    margin: auto;
    padding: 0 28px;
  }

  .header {
    background: #f8f6f1;
    border-bottom: 1px solid #e8e6df;
    position: relative;
    z-index: 10;
  }

  .header-inner {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
  }

  .brand img {
    display: block;
    width: auto;
    max-width: 220px;
    height: 64px;
    object-fit: contain;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .desktop-nav a {
    font-size: 13px;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: #648a77;
  }

  .contact-link {
    padding: 13px 20px;
    border: 1px solid #426a59;
    border-radius: 4px;
  }

  .mobile-menu { display: none; }

  .page-heading {
    background: #eaece4;
    padding: 100px 0;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 3px;
    color: #72917e;
  }

  h1, h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: normal;
  }

  h1 {
    font-size: clamp(42px, 6vw, 76px);
    line-height: 1.15;
    margin: 24px 0;
  }

  h1 span { color: #86a590; }

  .page-heading p {
    max-width: 600px;
    font-size: 16px;
    line-height: 1.9;
    color: #68776c;
  }

  .services { padding: 100px 0; }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .service-card {
    background: #efeee7;
    padding: 35px 30px;
    min-height: 300px;
    display: flex;
    flex-direction: column;
  }

  .number {
    color: #8fa998;
    font-size: 12px;
    margin-bottom: 45px;
  }

  .service-card h2 {
    font-size: 27px;
    line-height: 1.3;
    margin: 0 0 20px;
  }

  .service-card p {
    font-size: 14px;
    line-height: 1.9;
    color: #728074;
    flex: 1;
  }

  .line {
    display: block;
    width: 45px;
    height: 2px;
    background: #8ba993;
    margin-top: 20px;
  }

  .contact-section {
    background: #355b4b;
    color: #ffffff;
    padding: 80px 0;
  }

  .contact-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .contact-section .eyebrow { color: #c5d8ca; }

  .contact-section h2 {
    font-size: clamp(30px, 4vw, 48px);
    margin: 18px 0;
  }

  .contact-section p {
    color: #d2dfd4;
    font-size: 14px;
    line-height: 1.8;
    max-width: 550px;
  }

  .button {
    display: inline-block;
    background: #f8f6f1;
    color: #355b4b;
    padding: 18px 25px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
    text-decoration: none;
    white-space: nowrap;
  }

  footer {
    background: #eaece4;
    padding: 30px 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    color: #758177;
    font-size: 12px;
  }

  @media (max-width: 850px) {
    .desktop-nav { display: none; }

    .mobile-menu { display: block; }

    .mobile-menu summary {
      cursor: pointer;
      list-style: none;
      font-size: 14px;
      color: #355b4b;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #f8f6f1;
      display: flex;
      flex-direction: column;
      padding: 20px 28px;
      box-shadow: 0 12px 24px rgba(0,0,0,0.08);
    }

    .mobile-menu nav a {
      text-decoration: none;
      padding: 13px 0;
      border-bottom: 1px solid #e5e7e0;
    }

    .service-grid { grid-template-columns: repeat(2, 1fr); }

    .contact-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (max-width: 560px) {
    .container { padding: 0 20px; }

    .page-heading { padding: 65px 0; }

    .services { padding: 65px 0; }

    .service-grid { grid-template-columns: 1fr; }

    .service-card { min-height: 240px; }

    .number { margin-bottom: 30px; }

    .footer-inner { flex-direction: column; }

    .brand img {
      max-width: 175px;
      height: 56px;
    }
  }
</style>

---
import SEOHead from "../components/SEOHead.astro";

import Header from "../components/Header.astro";

import iletisim from "../data/iletisim.json";

import seo from "../data/seo.json";

import Footer from "../components/Footer.astro";

import gorseller from "../data/gorseller.json";



const telefon = iletisim.telefon.replace(/^\+/, "");
const whatsapp = `https://wa.me/${iletisim.whatsapp.replace(/\D/g, "")}`;
const eposta = iletisim.email;
const adres = iletisim.adres;
const harita = iletisim.haritaLinki;



---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f6f1" />
    <SEOHead
      title={seo.iletisim.title}
      description={seo.iletisim.description}
      sayfaTuru="ContactPage"
      yol={[{ ad: "Ana Sayfa", yol: "/" }, { ad: "İletişim", yol: "/iletisim/" }]}
    />
  </head>

  <body>
  
    <Header />

    
<main>
  <section class="page-heading">
    <div class="container">
      <span class="eyebrow">BİZE ULAŞIN</span>

      <h1>
        {iletisim.sayfaBasligi}
      </h1>

      <p>{iletisim.sayfaAciklamasi}</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="section-intro">
        <span class="eyebrow">İLETİŞİM KANALLARI</span>
        <h2>Nasıl ulaşabilirsiniz?</h2>
      </div>

      <div class="contact-grid">

        <article class="contact-card">
          <span class="card-icon">01</span>
          <h3>WhatsApp</h3>

          <p>
            Görüşme ve randevu hakkında bilgi almak için
            WhatsApp üzerinden mesaj gönderebilirsiniz.
          </p>

          <a
            class="card-link"
            href={whatsapp}
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp'tan Yazın ↗
          </a>
        </article>

        <article class="contact-card">
          <span class="card-icon">02</span>
          <h3>Telefon</h3>

          <p>
            Telefon üzerinden görüşme ve randevu
            bilgisi alabilirsiniz.
          </p>

          <a
            class="card-link"
            href={`tel:+${telefon}`}
          >
            {iletisim.telefonGorunen} ↗
          </a>
        </article>

        <article class="contact-card">
          <span class="card-icon">03</span>
          <h3>E-posta</h3>

          <p>
            Genel sorularınız ve görüşme sürecine
            ilişkin bilgi talepleriniz için.
          </p>

          <a
            class="card-link"
            href={`mailto:${eposta}`}
          >
            {eposta} ↗
          </a>
        </article>

      </div>
    </div>
  </section>

  <section class="location-section">
    <div class="container location-grid">
      <div>
        <span class="eyebrow">KONUM</span>

        <h2>Serdivan, Sakarya</h2>

        <p>{adres}</p>

        <a
          href={harita}
          class="button"
          target="_blank"
          rel="noopener noreferrer"
        >
          Google Haritalar'da Aç ↗
        </a>
      </div>

      
      <div class="office-photo">
        <img
          src={gorseller.ofisFotografi}
          alt={gorseller.ofisAlt}
          width="900"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </div>

    </div>
  </section>

  <section class="disclaimer">
    <div class="container">
      <p>
        Bu sayfa genel bilgilendirme ve randevu iletişimi
        amaçlıdır. WhatsApp veya e-posta üzerinden hassas
        sağlık bilgilerinizi paylaşmayınız.
      </p>
    </div>
  </section>
</main>


    <Footer />
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #293b34;
    font-family: Arial, sans-serif;
  }

  :global(a) { color: inherit; }

  .container {
    max-width: 1160px;
    padding: 0 28px;
    margin: auto;
  }

  .header {
    background: #f8f6f1;
    border-bottom: 1px solid #e5e9e1;
    position: relative;
    z-index: 10;
  }

  .header-inner {
    min-height: 90px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 25px;
  }

  .logo {
    display: block;
    width: auto;
    max-width: 210px;
    height: 62px;
    object-fit: contain;
  }

  .desktop-nav {
    display: flex;
    gap: 28px;
    align-items: center;
  }

  .desktop-nav a {
    font-size: 13px;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current] {
    color: #648a77;
  }

  .mobile-menu { display: none; }

  .page-heading {
    background: #eaece4;
    padding: 100px 0;
  }

  .eyebrow {
    color: #72917e;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 3px;
  }

  h1, h2, h3 {
    font-family: Georgia, serif;
    font-weight: normal;
  }

  h1 {
    font-size: clamp(48px, 6vw, 76px);
    margin: 20px 0;
  }

  h1 span, h2 span {
    color: #86a590;
  }

  .page-heading p {
    max-width: 620px;
    color: #68776c;
    line-height: 1.9;
    font-size: 16px;
  }

  .contact-section {
    padding: 100px 0;
  }

  .section-intro h2 {
    font-size: clamp(34px, 4vw, 48px);
    margin: 20px 0 45px;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  .contact-card {
    background: #efeee7;
    padding: 35px;
    min-height: 310px;
    display: flex;
    flex-direction: column;
  }

  .card-icon {
    color: #8ba993;
    font-size: 13px;
    margin-bottom: 35px;
  }

  .contact-card h3 {
    font-size: 30px;
    margin: 0 0 20px;
  }

  .contact-card p {
    color: #69796e;
    font-size: 14px;
    line-height: 1.9;
    flex: 1;
  }

  .card-link {
    color: #355b4b;
    font-weight: bold;
    font-size: 13px;
    text-decoration: none;
    padding-top: 22px;
    border-top: 1px solid #cdd8cd;
    overflow-wrap: anywhere;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .location-section {
    background: #eaece4;
    padding: 90px 0;
  }

  .location-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 70px;
  }

  .location-grid h2 {
    font-size: clamp(38px, 4vw, 54px);
    margin: 22px 0;
  }

  .location-grid p {
    color: #64756a;
    line-height: 1.9;
    margin-bottom: 30px;
    max-width: 360px;
  }

  .button {
    display: inline-block;
    padding: 17px 25px;
    background: #355b4b;
    color: white;
    font-size: 13px;
    font-weight: bold;
    border-radius: 4px;
    text-decoration: none;
  }


  .disclaimer {
    padding: 35px 0;
    font-size: 12px;
    color: #809085;
    line-height: 1.8;
  }

  footer {
    padding: 35px 0;
    background: #eaece4;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    font-size: 12px;
    color: #758177;
  }

  .footer-inner strong {
    font-family: Georgia, serif;
    font-size: 18px;
    font-weight: normal;
  }

  @media (max-width: 850px) {
    .desktop-nav { display: none; }

    .mobile-menu { display: block; }

    .mobile-menu summary {
      cursor: pointer;
      list-style: none;
      color: #355b4b;
      font-size: 14px;
    }

    .mobile-menu nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #f8f6f1;
      display: flex;
      flex-direction: column;
      padding: 18px 28px;
      box-shadow: 0 12px 25px rgba(0,0,0,0.08);
    }

    .mobile-menu nav a {
      padding: 13px 0;
      text-decoration: none;
      border-bottom: 1px solid #e4e8e1;
    }

    .contact-grid {
      grid-template-columns: 1fr;
    }

    .location-grid {
      grid-template-columns: 1fr;
      gap: 35px;
    }
  }

  @media (max-width: 560px) {
    .container { padding: 0 20px; }

    .header-inner { min-height: 75px; }

    .logo {
      max-width: 175px;
      height: 54px;
    }

    .page-heading {
      padding: 65px 0;
    }

    .contact-section {
      padding: 65px 0;
    }

    .contact-card {
      min-height: 240px;
    }

    .location-section {
      padding: 65px 0;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  
/* GÖRÜŞME ODASI FOTOĞRAFI — sade, çerçevesiz, kırpılmadan */
  .office-photo {
    width: 100%;
    min-width: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .office-photo img {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 510px;
    object-fit: contain;
    border: none;
    border-radius: 0;
  }

  @media (max-width: 850px) {
    .office-photo img {
      max-height: 460px;
    }
  }

  @media (max-width: 560px) {
    .office-photo img {
      max-height: 420px;
    }
  }

</style>


---

import SEOHead from "../components/SEOHead.astro";

import Header from "../components/Header.astro";

import GorusmeSecenekleri from "../components/GorusmeSecenekleri.astro";

import anasayfa from "../data/anasayfa.json";

import iletisimBilgileri from "../data/iletisim.json";

import seo from "../data/seo.json";

import gorseller from "../data/gorseller.json";

import Footer from "../components/Footer.astro";




const hizmetDosyalari = import.meta.glob(
  "../data/calisma-alanlari/*.json",
  {
    eager: true,
    import: "default"
  }
);

const hizmetler = Object.values(hizmetDosyalari)
  .filter((alan) =>
    alan &&
    alan.baslik &&
    alan.yayinda !== false
  )
  .sort((a, b) =>
    Number(a.sira ?? 999) - Number(b.sira ?? 999)
  )
  .map((alan, index) => ({
    ...alan,
    no: String(index + 1).padStart(2, "0")
  }));

---

<!doctype html>
<html lang="tr">
  
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f8f6f1" />

  
<SEOHead
  title={seo.anasayfa.title}
  description={seo.anasayfa.description}
/>

</head>


  <body>
   
<Header />

      <main>
      <section id="anasayfa" class="hero">
        <div class="container hero-grid">
          <div class="hero-content">
            <span class="eyebrow">SAKARYA · SERDİVAN</span>

            
<h1>{anasayfa.anaBaslik}</h1>


            
<p class="hero-description">
  {anasayfa.anaAciklama}
</p>


            <div class="hero-actions">
              <a href="/iletisim" class="button button-primary">
                İletişime Geçin <span aria-hidden="true">↗</span>
              </a>
              <a href="/hakkimda" class="button button-text">
                Hakkımda <span aria-hidden="true">→</span>
              </a>
            </div>

            <div class="hero-note">
              <span class="note-line"></span>
              <span>Çocuk · Ergen · Yetişkin</span>
            </div>
          </div>

          
<div class="hero-visual">
  

<img
  src={gorseller.anaSayfaFotografi}
  alt={gorseller.anaSayfaAlt}
  loading="eager"
  decoding="async"
  style="display:block; width:100%; height:clamp(360px, 65vh, 560px); object-fit:cover; object-position:center 30%;"
/>



  <div class="visual-caption">
    <span>ELİF ÖZGÜR ÖNAL</span>
    <small>Klinik Psikolog</small>
  </div>
</div>

        </div>
      </section>

      <section class="intro-strip">
        <div class="container intro-inner">
          <span>PSİKOLOJİK DESTEK</span>
          <span class="strip-divider"></span>
          <p>
            Her bireyin yaşam öyküsü, ihtiyaçları ve değişim
            süreci kendine özgüdür.
          </p>
        </div>
      </section>

      <section id="hakkimda" class="section about">
        <div class="container about-grid">
          <div>
            <span class="eyebrow">BENİ TANIYIN</span>
            <h2>Hakkımda</h2>
            <div class="short-rule"></div>
          </div>

          <div class="about-content">
            <h3>Merhaba, ben Elif Özgür Önal.</h3>
            
              <p>{anasayfa.hakkimdaAciklama}</p>
            
            <p>
              Mesleki çalışmalarımda çocuk, ergen ve yetişkin
              danışanlarla çalışıyorum. Bilişsel Davranışçı
              Terapi, EMDR ve Deneyimsel Oyun Terapisi alanlarında
              eğitimler aldım.
            </p>
            <p>
              Sakarya Serdivan'daki merkezimde bireylerin
              ihtiyaçlarını ve yaşam öykülerini dikkate alan
              bir görüşme süreci yürütüyorum.
            </p>

            <div class="education-box">
              <span class="education-icon">✦</span>
              <div>
                <strong>Eğitim</strong>
                <p>Uludağ Üniversitesi – Psikoloji</p>
                <p>Üsküdar Üniversitesi – Klinik Psikoloji Yüksek Lisans</p>
              </div>
            </div>
          </div>
        </div>
      </section>
      
      <GorusmeSecenekleri />
      <section id="hizmetler" class="section services">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="eyebrow">UZMANLIK VE ÇALIŞMALAR</span>
              <h2>Çalışma Alanları</h2>
            </div>
            <p>
              Farklı yaş gruplarına ve ihtiyaçlara yönelik
              psikolojik değerlendirme ve terapi çalışmaları.
            </p>
          </div>

          <div class="service-grid">
            {hizmetler.map((hizmet) => (
              <article class="service-card">
                <span class="service-number">{hizmet.no}</span>
                <h3>{hizmet.baslik}</h3>
                <p>{hizmet.aciklama}</p>
                <span class="service-line"></span>
              </article>
            ))}
          </div>
        </div>
      </section>
      

<section id="iletisim" class="section contact">
  <div class="container">
    <span class="eyebrow">BİZE ULAŞIN</span>

    <h2>
      {anasayfa.iletisimBaslik}
    </h2>

    <p class="contact-description">
      {anasayfa.iletisimAciklama}
    </p>

    <div class="contact-methods">

      <!-- TELEFON -->
      <a
        class="contact-method"
        href={`tel:${iletisimBilgileri.telefon}`}
      >
        <span class="contact-number">01 / TELEFON</span>

        <h3>Telefonla İletişim</h3>

        <p>
          Görüşme ve randevu hakkında bilgi almak için
          telefonla iletişime geçebilirsiniz.
        </p>

        <div class="contact-method-footer">
          <strong>{iletisimBilgileri.telefonGorunen}</strong>
          <span aria-hidden="true">↗</span>
        </div>
      </a>

      <!-- WHATSAPP -->
      <a
        class="contact-method"
        href={`https://wa.me/${iletisimBilgileri.whatsapp.replace(/\D/g, "")}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        <span class="contact-number">02 / WHATSAPP</span>

        <h3>WhatsApp</h3>

        <p>
          Yüz yüze veya online terapi görüşmeleri
          hakkında bilgi almak için mesaj gönderebilirsiniz.
        </p>

        <div class="contact-method-footer">
          <strong>WhatsApp'tan Yazın</strong>
          <span aria-hidden="true">↗</span>
        </div>
      </a>

      <!-- E-POSTA -->
      <a
        class="contact-method"
        href={`mailto:${iletisimBilgileri.email}`}
      >
        <span class="contact-number">03 / E-POSTA</span>

        <h3>E-posta</h3>

        <p>
          Genel sorularınız ve görüşme süreci hakkında
          e-posta üzerinden iletişime geçebilirsiniz.
        </p>

        <div class="contact-method-footer">
          <strong>{iletisimBilgileri.email}</strong>
          <span aria-hidden="true">↗</span>
        </div>
      </a>

    </div>
  </div>
</section>

    </main>

    <Footer />
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
    scroll-padding-top: 95px;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #293b34;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 28px;
  }

  .header {
    background: rgba(248, 246, 241, 0.96);
    border-bottom: 1px solid #e8e6df;
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .header-inner, .brand, nav, .hero-actions,
  .intro-inner, .section-heading, .banner-inner,
  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header-inner {
    min-height: 92px;
    gap: 20px;
  }

  .brand {
    justify-content: flex-start;
    gap: 13px;
    text-decoration: none;
  }

  .brand-symbol {
    font-family: Georgia, serif;
    color: #527969;
    font-size: 38px;
    line-height: 1;
  }

  .brand-name {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .brand-name strong {
    font-family: Georgia, serif;
    font-size: 18px;
    font-weight: normal;
  }

  .brand-name small {
    font-size: 9px;
    letter-spacing: 2.7px;
    color: #77857d;
  }

  nav {
    gap: 29px;
  }

  nav a {
    text-decoration: none;
    font-size: 13px;
    font-weight: 500;
  }

  nav a:hover {
    color: #648a77;
  }

  nav .nav-contact {
    border: 1px solid #426a59;
    border-radius: 4px;
    padding: 13px 21px;
  }

  .hero {
    padding: 88px 0 105px;
    overflow: hidden;
  }

  .hero-grid, .about-grid {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 70px;
    align-items: center;
  }

  .hero-content {
    padding: 26px 0;
  }

  .eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 3px;
    color: #72917e;
  }

  h1, h2, h3, p {
    margin-top: 0;
  }

  h1, h2, .about-content h3, .banner-inner h2 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: normal;
  }

  h1 {
    font-size: clamp(46px, 5.2vw, 76px);
    line-height: 1.12;
    letter-spacing: -2px;
    margin: 25px 0;
  }

  h1 span {
    color: #61836f;
    display: block;
  }

  .hero-description {
    color: #6d7972;
    line-height: 1.9;
    font-size: 16px;
    max-width: 510px;
    margin-bottom: 30px;
  }

  .hero-actions {
    justify-content: flex-start;
    gap: 22px;
    flex-wrap: wrap;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 17px 25px;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
    transition: transform 0.2s, background 0.2s;
  }

  .button:hover {
    transform: translateY(-2px);
  }

  .button-primary {
    background: #355b4b;
    color: white;
  }

  .button-primary:hover {
    background: #274839;
  }

  .button-text {
    padding-left: 0;
    color: #355b4b;
  }

  .hero-note {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 65px;
    font-size: 11px;
    color: #849087;
    letter-spacing: 1.2px;
  }

  .note-line {
    width: 40px;
    height: 1px;
    background: #9baa9d;
  }

  .hero-visual {
    min-height: 520px;
    background: #dce5da;
    border-radius: 220px 220px 6px 6px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .visual-ring {
    border: 1px solid rgba(255,255,255,0.65);
    border-radius: 50%;
    position: absolute;
    width: 420px;
    height: 420px;
  }

  .ring-two {
    width: 320px;
    height: 320px;
  }

  .ring-three {
    width: 225px;
    height: 225px;
  }

  .hero-monogram {
    font-family: Georgia, serif;
    font-size: 130px;
    font-style: italic;
    color: #527563;
    position: relative;
    z-index: 1;
    letter-spacing: -18px;
    padding-right: 18px;
  }

  .visual-caption {
    position: absolute;
    bottom: 35px;
    left: 35px;
    right: 35px;
    border-top: 1px solid rgba(68, 99, 77, 0.3);
    padding-top: 15px;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 10px;
    letter-spacing: 1.2px;
  }

  .visual-caption small {
    font-size: 10px;
  }

  .intro-strip {
    background: #eaece4;
    padding: 31px 0;
  }

  .intro-inner {
    justify-content: flex-start;
    gap: 35px;
  }

  .intro-inner > span:first-child {
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  .strip-divider {
    height: 35px;
    width: 1px;
    background: #bfc9ba;
  }

  .intro-inner p {
    margin: 0;
    font-family: Georgia, serif;
    font-size: 19px;
    color: #536b5b;
  }

  .section {
    padding: 115px 0;
  }

  h2 {
    font-size: clamp(36px, 4.2vw, 55px);
    line-height: 1.2;
    margin: 20px 0 30px;
  }

  .dot {
    color: #8baa95;
  }

  .about-grid {
    align-items: start;
    grid-template-columns: 0.8fr 1.2fr;
  }

  .short-rule {
    width: 74px;
    height: 2px;
    background: #86a590;
  }

  .about-content h3 {
    font-size: 28px;
    margin-bottom: 20px;
  }

  .about-content > p {
    font-size: 15px;
    line-height: 2;
    color: #68756d;
  }

  .education-box {
    display: flex;
    gap: 20px;
    margin-top: 29px;
    padding: 27px;
    background: #efeee7;
    border-left: 3px solid #91a996;
  }

  .education-icon {
    font-size: 29px;
    color: #72917e;
  }

  .education-box strong {
    font-size: 14px;
  }

  .education-box p {
    color: #6c766e;
    font-size: 13px;
    line-height: 1.6;
    margin: 9px 0 0;
  }

  .services {
    background: #f0f1eb;
  }

  .section-heading {
    gap: 30px;
    align-items: end;
    margin-bottom: 40px;
  }

  .section-heading h2 {
    margin-bottom: 0;
  }

  .section-heading > p {
    max-width: 330px;
    font-size: 14px;
    line-height: 1.9;
    color: #737d74;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 17px;
  }

  .service-card {
    min-height: 270px;
    background: #fbfaf6;
    padding: 34px 30px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s;
  }

  .service-card:hover {
    transform: translateY(-4px);
  }

  .service-number {
    color: #92aa98;
    font-size: 12px;
    margin-bottom: 45px;
  }

  .service-card h3 {
    font-family: Georgia, serif;
    font-weight: normal;
    font-size: 23px;
    line-height: 1.3;
    margin-bottom: 14px;
  }

  .service-card p {
    font-size: 13px;
    line-height: 1.8;
    color: #78837a;
    flex: 1;
  }

  .service-line {
    width: 35px;
    height: 1px;
    background: #87a28e;
    margin-top: 20px;
  }

  .contact-banner {
    background: #355b4b;
    color: white;
    padding: 78px 0;
  }

  .banner-inner {
    gap: 35px;
  }

  .eyebrow-light {
    color: #bed1c0;
  }

  .banner-inner h2 {
    font-size: clamp(32px, 4vw, 48px);
    margin: 15px 0;
  }

  .banner-inner p {
    color: #d2dfd4;
    max-width: 550px;
    font-size: 14px;
    line-height: 1.8;
    margin-bottom: 0;
  }

  .button-light {
    background: #f8f6f1;
    color: #355b4b;
    white-space: nowrap;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 45px;
    margin-top: 48px;
  }

  .contact-item {
    border-top: 1px solid #cad4ca;
    padding-top: 23px;
    min-width: 0;
  }

  .contact-label {
    display: block;
    color: #809486;
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 17px;
  }

  .contact-item a, .contact-item p {
    font-size: 15px;
    line-height: 1.8;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-item a:hover {
    text-decoration: underline;
  }

  .contact-disclaimer {
    margin: 65px 0 0;
    color: #879187;
    font-size: 12px;
    line-height: 1.7;
  }

  .footer {
    background: #eaece4;
    padding: 35px 0;
  }

  .footer-inner {
    gap: 20px;
  }

  .footer-inner div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-inner strong {
    font-family: Georgia, serif;
    font-size: 19px;
    font-weight: normal;
  }

  .footer-inner span, .footer-inner p {
    font-size: 11px;
    color: #758177;
    margin: 0;
  }

  @media (max-width: 850px) {
    .header-inner {
      flex-direction: column;
      padding-top: 17px;
      padding-bottom: 17px;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 13px 20px;
    }

    nav a {
      font-size: 12px;
    }

    nav .nav-contact {
      padding: 8px 12px;
    }

    .hero {
      padding: 50px 0 65px;
    }

    .hero-grid, .about-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-visual {
      min-height: 410px;
      max-width: 550px;
      width: 100%;
      margin: auto;
    }

    .hero-note {
      margin-top: 40px;
    }

    .section {
      padding: 75px 0;
    }

    .service-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .contact-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }
  }

  @media (max-width: 560px) {
    .container {
      padding: 0 20px;
    }

    .brand-name strong {
      font-size: 16px;
    }

    h1 {
      font-size: 45px;
      letter-spacing: -1px;
    }

    .hero-description {
      font-size: 14px;
    }

    .hero-visual {
      min-height: 360px;
    }

    .hero-monogram {
      font-size: 100px;
    }

    .intro-inner {
      align-items: flex-start;
      gap: 15px;
    }

    .intro-inner p {
      font-size: 15px;
      line-height: 1.5;
    }

    .strip-divider {
      height: 50px;
    }

    .section-heading, .banner-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .section-heading {
      gap: 12px;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-card {
      min-height: 220px;
    }

    .service-number {
      margin-bottom: 30px;
    }

    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) {
      scroll-behavior: auto;
    }

    .button, .service-card {
      transition: none;
    }
  }

/* Gerçek logo */
.brand-logo {
  display: block;
  width: auto;
  max-width: 220px;
  height: 64px;
  object-fit: contain;
}

/* Profil fotoğrafı alanı */
.hero-visual {
  background: #dbe5dc;
  isolation: isolate;
}

/* Elif'in fotoğrafı */
.hero-photo {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 28%;
}

/* Fotoğrafın alt kısmındaki koyu geçiş */
.hero-visual::after {
  content: "";
  position: absolute;
  inset: 55% 0 0;
  background: linear-gradient(
    to bottom,
    transparent,
    rgba(24, 43, 34, 0.65)
  );
  pointer-events: none;
}

/* Fotoğraf üzerindeki isim */
.visual-caption {
  z-index: 2;
  color: #ffffff;
  border-top-color: rgba(255, 255, 255, 0.55);
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
}

/* Mobil görünüm */
@media (max-width: 560px) {
  .brand-logo {
    height: 56px;
    max-width: 190px;
  }

  .hero-visual {
    min-height: 430px;
  }

  .visual-caption {
    bottom: 24px;
    left: 22px;
    right: 22px;
  }
}

/* Mobil menü başlangıçta gizli */
.mobile-menu {
  display: none;
}

.mobile-menu summary {
  cursor: pointer;
  list-style: none;
  font-size: 14px;
  font-weight: 600;
  color: #355b4b;
}

.mobile-menu summary::-webkit-details-marker {
  display: none;
}

.mobile-menu summary span {
  font-size: 21px;
  margin-left: 8px;
}

/* Tablet ve telefon */
@media (max-width: 850px) {
  .desktop-nav {
    display: none;
  }

  .header-inner {
    flex-direction: row;
    justify-content: space-between;
    min-height: 76px;
    gap: 12px;
  }

  .mobile-menu {
    display: block;
  }

  .mobile-menu nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    padding: 15px 25px;
    background: #f8f6f1;
    border-bottom: 1px solid #e2e6df;
    box-shadow: 0 15px 25px rgba(0,0,0,0.06);
  }

  .mobile-menu nav a {
    padding: 14px 5px;
    font-size: 14px;
    text-decoration: none;
    border-bottom: 1px solid #e9eae4;
  }

  .mobile-menu nav a:last-child {


---

import Header from "../../components/Header.astro";

import type { MarkdownInstance } from "astro";

interface Yazi {
  title: string;
  description: string;
  date: string;
  category: string;
}

const yazilar = Object.values(
  import.meta.glob<MarkdownInstance<Yazi>>("./*.md", {
    eager: true
  })
).sort((a, b) =>
  b.frontmatter.date.localeCompare(a.frontmatter.date)
);
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f8f6f1" />

    <title>Psikoloji Yazıları | Klinik Psikolog Elif Özgür Önal</title>

    <meta
      name="description"
      content="Psikoloji, duygular, çocuk gelişimi ve psikolojik destek süreçleri hakkında bilgilendirici yazılar."
    />
  </head>

  <body>
   
    <Header />

    <main>
      <section class="page-heading">
        <div class="container">
          <span class="eyebrow">BİLGİ VE FARKINDALIK</span>
          <h1>Psikoloji Yazıları<span>.</span></h1>
          <p>
            Psikoloji, insan davranışları, duygusal süreçler
            ve kişisel gelişim üzerine bilgilendirici içerikler.
          </p>
        </div>
      </section>

      <section class="blog-section">
        <div class="container">
          <div class="section-intro">
            <div>
              <span class="eyebrow">BLOG</span>
              <h2>Yazıları Keşfedin</h2>
            </div>
            <p>
              Psikolojiye ilişkin konuları daha yakından
              tanımak ve farklı bakış açıları edinmek için.
            </p>
          </div>

          <div class="blog-grid">
            {yazilar.map((yazi) => (
              <article class="blog-card">
                <span class="category">
                  {yazi.frontmatter.category}
                </span>

                <h3>{yazi.frontmatter.title}</h3>

                <p>{yazi.frontmatter.description}</p>

                <div class="card-bottom">
                  <time datetime={yazi.frontmatter.date}>
                    {yazi.frontmatter.date
                      .split("-")
                      .reverse()
                      .join(".")}
                  </time>

                  <a
                    href={yazi.url ?? "/blog"}
                    aria-label={`${yazi.frontmatter.title} yazısını oku`}
                  >
                    Yazıyı Oku <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="contact-banner">
        <div class="container banner-inner">
          <div>
            <span class="eyebrow">İLETİŞİM</span>
            <h2>Bir sorunuz mu var?</h2>
            <p>
              Görüşme süreci hakkında bilgi almak için
              iletişime geçebilirsiniz.
            </p>
          </div>

          <a href="/iletisim" class="button">
            İletişime Geçin ↗
          </a>
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <strong>Elif Özgür Önal</strong>
        <span>© 2026 · Tüm hakları saklıdır.</span>
      </div>
    </footer>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background: #f8f6f1;
    color: #293b34;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-font-smoothing: antialiased;
  }

  :global(a) {
    color: inherit;
  }

  .container {
    max-width: 1160px;
    margin: auto;
    padding: 0 28px;
  }

  .header {
    background: #f8f6f1;
    border-bottom: 1px solid #e8e6df;
    position: relative;
    z-index: 10;
  }

  .header-inner {
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
  }

  .brand img {
    display: block;
    width: auto;
    height: 62px;
    max-width: 210px;
    object-fit: contain;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 25px;
  }

  .desktop-nav a {
    font-size: 13px;
    text-decoration: none;
  }

  .desktop-nav a:hover,
  .desktop-nav a[aria-current="page"] {
    color: #648a77;
  }

  .nav-contact {
    padding: 13px 20px;
    border: 1px solid #426a59;
    border-radius: 4px;
  }

  .mobile-menu {
    display: none;
  }

  .page-heading {
    background: #eaece4;
    padding: 95px 0;
  }

  .eyebrow {
    color: #72917e;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 3px;
  }

  h1, h2, h3 {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: normal;
  }

  h1 {
    font-size: clamp(43px, 6vw, 76px);
    line-height: 1.2;
    margin: 25px 0;
  }

  h1 span {
    color: #86a590;
  }

  .page-heading p {
    max-width: 610px;
    color: #68776c;
    line-height: 1.9;
    font-size: 16px;
  }

  .blog-section {
    padding: 100px 0;
  }

  .section-intro {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 35px;
    margin-bottom: 45px;
  }

  .section-intro h2 {
    font-size: clamp(32px, 4vw, 49px);
    margin: 18px 0 0;
  }

  .section-intro > p {
    max-width: 330px;
    font-size: 14px;
    line-height: 1.9;
    color: #758177;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 25px;
  }

  .blog-card {
    background: #efeee7;
    padding: 40px;
    min-height: 330px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s;
  }

  .blog-card:hover {
    transform: translateY(-4px);
  }

  .category {
    color: #72917e;
    font-size: 11px;
    letter-spacing: 1.5px;
    font-weight: bold;
  }

  .blog-card h3 {
    font-size: 30px;
    line-height: 1.3;
    margin: 25px 0 15px;
  }

  .blog-card p {
    font-size: 14px;
    color: #718075;
    line-height: 1.9;
    flex: 1;
  }

  .card-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #d1d8cc;
    padding-top: 22px;
    margin-top: 28px;
    gap: 15px;
  }

  .card-bottom time {
    font-size: 12px;
    color: #8b978c;
  }

  .card-bottom a {
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
    color: #355b4b;
  }

  .card-bottom a:hover {
    text-decoration: underline;
  }

  .contact-banner {
    background: #355b4b;
    color: #ffffff;
    padding: 75px 0;
  }

  .banner-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
  }

  .contact-banner .eyebrow {
    color: #c7d7ca;
  }

  .contact-banner h2 {
    font-size: 43px;
    margin: 15px 0;
  }

  .contact-banner p {
    font-size: 14px;
    line-height: 1.8;
    color: #d2dfd4;
  }

  .button {
    padding: 17px 25px;
    background: #f8f6f1;
    color: #355b4b;
    border-radius: 4px;
    text-decoration: none;
    font-size: 13px;
    font-weight: bold;
    white-space: nowrap;
  }

  footer {
    background: #eaece4;
    padding: 35px 0;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 20px;
  }

  .footer-inner strong {
    font-family: Georgia, serif;
    font-size: 18px;
    font-weight: normal;
  }

  .footer-inner span {
    font-size: 12px;
    color: #758177;
  }

  @media (max-width: 850px) {
    .desktop-nav {
      display: none;
    }

    .mobile-menu {
      display: block;
    }

    .mobile-menu summary {
      cursor: pointer;
      list-style: none;
      font-size: 14px;
      color: #355b4b;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: flex;
      flex-direction: column;
      background: #f8f6f1;
      padding: 20px 28px;
      box-shadow: 0 12px 24px rgba(0,0,0,0.08);
    }

    .mobile-menu nav a {
      padding: 13px 0;
      text-decoration: none;
      border-bottom: 1px solid #e5e7e0;
    }

    .blog-grid {
      grid-template-columns: 1fr;
    }

    .banner-inner {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .container {
      padding: 0 20px;
    }

    .header-inner {
      min-height: 75px;
    }

    .brand img {
      max-width: 175px;
      height: 54px;
    }

    .page-heading {
      padding: 60px 0;
    }

    .blog-section {
      padding: 65px 0;
    }

    .section-intro {
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }

    .blog-card {
      padding: 28px;
      min-height: 280px;
    }

    .blog-card h3 {
      font-size: 26px;
    }

    .contact-banner h2 {
      font-size: 35px;
    }

    .footer-inner {
      flex-direction: column;
    }
  }
</style>
